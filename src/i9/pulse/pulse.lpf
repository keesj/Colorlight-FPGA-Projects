LOCATE COMP "clk_i" SITE "P3";
IOBUF PORT "clk_i" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk_i" 25 MHZ;

LOCATE COMP "led_o" SITE "L2";


# 4 gpio's
LOCATE COMP "gpio[0]" SITE "F2";
LOCATE COMP "gpio[1]" SITE "F1";
LOCATE COMP "gpio[2]" SITE "G3";
LOCATE COMP "gpio[3]" SITE "H4";
LOCATE COMP "gpio[4]" SITE "J4";
IOBUF  PORT "gpio[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "gpio[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "gpio[2]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "gpio[3]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "gpio[4]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

IOBUF PORT "led_o" IO_TYPE=LVCMOS33;

