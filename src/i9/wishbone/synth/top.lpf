BLOCK RESETPATHS;
BLOCK ASYNCPATHS;

# The clock "usb" and "gpdi" sheet
LOCATE COMP "clk" SITE "P3";
IOBUF  PORT "clk" PULLMODE=NONE IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk" 25 MHZ;

# 4 gpio's
# P4 header on the i5 extension board
LOCATE COMP "gpio[0]" SITE "F1";
LOCATE COMP "gpio[1]" SITE "G3";
LOCATE COMP "gpio[2]" SITE "H4";
LOCATE COMP "gpio[3]" SITE "J4";
IOBUF  PORT "gpio[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "gpio[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "gpio[2]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "gpio[3]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

# User led on module
LOCATE COMP "user_led" SITE "L2";
IOBUF  PORT "user_led" IO_TYPE=LVCMOS33;

LOCATE  COMP "ser_tx"  SITE "J17";
IOBUF   PORT "ser_tx"  IO_TYPE=LVCMOS33;

LOCATE  COMP "ser_rx"  SITE "H18";
IOBUF   PORT "ser_rx"  IO_TYPE=LVCMOS33;
 
